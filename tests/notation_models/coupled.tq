# test_sparse_jacobian.coupled: every coupling path, B stored as (c, x)
model coupled
axis x in [0, 1] n=7 kind=bidirectional
axis c categorical [a1, a2, a3]
axis a in [0, 2] n=6 kind=one_way
param D0=0.05, K=2, chi=0.7, k=0.3, g=0.8, h=1.5
param r[c] = {a1: 0.2, a2: 0.1, a3: 0.05}

field N(x)
field B(c, x)
field I(a, x)
compartment A
compartment W

sat  = N/(K + N)
grow = g*sat*B
B_x  = sum_c(B)
load = int_a(int_x(I*B_x))
mix  = int_x(r[c]*B_x*N)

transitions M on c: a1 -> a2 = 0.1*A, a2 -> a3 = 0.05, a3 -> a1 = 0.02

d_t(N) = d_x(D0*(1 + N/K)*d_x(N)) - k*N*B_x
robin N at x=lower: h*(A - N)

d_t(B) = -d_x(chi*(N - 1)*B) + d_x(0.02*d_x(B)) + grow - r[c]*B - 0.01*mix*B
         + trans_c(M, 1e-3*grow) + trans_c(M, B)            using sharp
dirichlet B at x=lower: 0.1*A
outflow B at x=upper to W

d_t(I) = -d_a(I) - (0.4 + 0.1*N)*I     using sharp
inflow  I at a=lower: k*B_x*A
outflow I at a=upper

d_t(A) = -0.1*A + 1e-2*load
d_t(W) = -0.05*W

N(0) = 1
B(0) = 0.5
I(0) = 0.1
A(0) = 2
