# Three phenotypes switching in a cycle on a geometric grid, held and exchanged ends
model switch_bc
axis s categorical [A, B, C]
axis x in [0, 1] n=8 spacing=geometric ratio=1.3 kind=spatial
param q1=0.3, q2=0.05, r=0.2, d=0.1
field F(x, s)
transitions Q on s: A -> B = q1, B -> C = q2, C -> A = q1 + q2
d_t(F) = trans_s(Q, F) + d_x(0.05*d_x(F)) + r*F*(1 - x) - d*F
dirichlet F at x=lower: 2
robin F at x=upper: 3*(0.5 - F)
F(0) = 1
