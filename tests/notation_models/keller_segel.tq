# V43: Keller-Segel; the parameter beta shares its name with a shape function
model keller_segel
axis x in [0, 1] n=10 kind=spatial
param chi=5, alpha=1, beta=1
field n(x)
field c(x)
d_t(n) = -d_x(chi*grad(c, x)*n) + d_x(0.1*d_x(n))    using sharp
d_t(c) = d_x(1*d_x(c)) + alpha*n - beta*c
n(0) = 1 + 1e-6*exp(-((x - 0.3)/0.1)^2)
c(0) = 1
